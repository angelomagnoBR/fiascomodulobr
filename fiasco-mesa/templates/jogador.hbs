<section class="fiasco-ficha fiasco-jogador">
  <header class="fiasco-topo">
    <img class="fiasco-retrato" src="{{actor.img}}" alt="{{actor.name}}" data-action="trocarImagem" title="Trocar imagem">
    <div class="fiasco-identidade">
      <input class="fiasco-nome" type="text" name="name" value="{{actor.name}}" placeholder="Nome do personagem">
      <input type="text" name="system.conceito" value="{{system.conceito}}" placeholder="Quem é? (ex.: assessor parlamentar endividado)">
    </div>
  </header>

  <nav class="fiasco-abas">
    <button type="button" data-action="aba" data-aba="relacoes" class="{{#if aba.relacoes}}ativa{{/if}}"><i class="fas fa-people-arrows"></i> Relações</button>
    <button type="button" data-action="aba" data-aba="elementos" class="{{#if aba.elementos}}ativa{{/if}}"><i class="fas fa-briefcase"></i> Detalhes</button>
    <button type="button" data-action="aba" data-aba="notas" class="{{#if aba.notas}}ativa{{/if}}"><i class="fas fa-pen"></i> Anotações</button>
  </nav>

  <!-- ABA: RELAÇÕES -->
  <section class="fiasco-aba {{#if aba.relacoes}}ativa{{/if}}" data-aba="relacoes">
    <div class="fiasco-bloco fiasco-bloco-mapa">
      <svg class="fiasco-mini-mapa" viewBox="0 0 560 160" xmlns="http://www.w3.org/2000/svg">
        <line x1="280" y1="32" x2="105" y2="128" class="linha"/>
        <line x1="280" y1="32" x2="455" y2="128" class="linha"/>
        <rect x="190" y="8" width="180" height="46" rx="8" class="no eu"/>
        <text x="280" y="37" class="nome">{{actor.name}}</text>
        <text x="150" y="78" class="rotulo">{{system.esquerda.relacao}}</text>
        <text x="150" y="94" class="detalhe">{{system.esquerda.detalhe}}</text>
        <text x="410" y="78" class="rotulo">{{system.direita.relacao}}</text>
        <text x="410" y="94" class="detalhe">{{system.direita.detalhe}}</text>
        <rect x="15" y="108" width="180" height="42" rx="8" class="no vizinho"/>
        <text x="105" y="134" class="nome">{{esqNome}}</text>
        <rect x="365" y="108" width="180" height="42" rx="8" class="no vizinho"/>
        <text x="455" y="134" class="nome">{{dirNome}}</text>
      </svg>
      {{#if mapaAtivo}}
      <button type="button" class="fiasco-btn-mapa" data-action="abrirMapa"><i class="fas fa-diagram-project"></i> Mapa completo da mesa</button>
      {{/if}}
    </div>

    <div class="fiasco-relacoes">
      <div class="fiasco-bloco fiasco-postit">
        <h3>← Vizinho à esquerda</h3>
        <label>Jogador
          <select name="system.esquerda.vizinho">{{selectOptions vizinhos selected=system.esquerda.vizinho}}</select>
        </label>
        <label>Relação <input type="text" name="system.esquerda.relacao" value="{{system.esquerda.relacao}}" placeholder="Ex.: Trabalho — Lobista"></label>
        <label>Detalhe <input type="text" name="system.esquerda.detalhe" value="{{system.esquerda.detalhe}}" placeholder="Necessidade, Objeto ou Locação"></label>
      </div>

      <div class="fiasco-bloco fiasco-postit">
        <h3>Vizinho à direita →</h3>
        <label>Jogador
          <select name="system.direita.vizinho">{{selectOptions vizinhos selected=system.direita.vizinho}}</select>
        </label>
        <label>Relação <input type="text" name="system.direita.relacao" value="{{system.direita.relacao}}" placeholder="Ex.: Romance — Ex-Mulher"></label>
        <label>Detalhe <input type="text" name="system.direita.detalhe" value="{{system.direita.detalhe}}" placeholder="Necessidade, Objeto ou Locação"></label>
      </div>
    </div>
  </section>

  <!-- ABA: DETALHES (Necessidade, Objeto, Locação) -->
  <section class="fiasco-aba {{#if aba.elementos}}ativa{{/if}}" data-aba="elementos">
    <div class="fiasco-bloco">
      <label>Necessidade <input type="text" name="system.necessidade" value="{{system.necessidade}}" placeholder="Ex.: De entrar no esquema — por não ter opção"></label>
      <label>Objeto <input type="text" name="system.objeto" value="{{system.objeto}}" placeholder="Ex.: Mala de dólares"></label>
      <label>Locação <input type="text" name="system.local" value="{{system.local}}" placeholder="Ex.: Cafezinho da Câmara"></label>
    </div>

    <div class="fiasco-bloco">
      <h3>Dados recebidos</h3>
      <div class="fiasco-contadores">
        <div class="fiasco-contador branco">
          <span>Brancos</span>
          <button type="button" data-action="contador" data-campo="brancos" data-passo="-1">−</button>
          <b>{{system.brancos}}</b>
          <button type="button" data-action="contador" data-campo="brancos" data-passo="1">+</button>
        </div>
        <div class="fiasco-contador preto">
          <span>Pretos</span>
          <button type="button" data-action="contador" data-campo="pretos" data-passo="-1">−</button>
          <b>{{system.pretos}}</b>
          <button type="button" data-action="contador" data-campo="pretos" data-passo="1">+</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ABA: ANOTAÇÕES -->
  <section class="fiasco-aba {{#if aba.notas}}ativa{{/if}}" data-aba="notas">
    <textarea class="fiasco-notas" name="system.notas" placeholder="Planos, segredos, o que deu errado...">{{system.notas}}</textarea>
  </section>
</section>
